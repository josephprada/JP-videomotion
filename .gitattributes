# Finales de línea LF en todo el repo (los .sh con CRLF fallan en macOS y Linux)
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Pesados por Git LFS (git lfs install)
videos/*/entregables/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
videos/*/voz/*.mp3 filter=lfs diff=lfs merge=lfs -text

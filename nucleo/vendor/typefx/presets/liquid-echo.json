{
  "id": "liquid-echo",
  "name": "Liquid Echo",
  "description": "Onda sinusoidal sobre los contornos y siete copias retardadas que dibujan la estela.",
  "source": { "text": "LIQUID", "cap": 220, "x": 960, "y": 420, "align": "center", "wght": 900, "wdth": 110 },
